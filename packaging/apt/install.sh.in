#!/usr/bin/env sh
#
# Add the LLM Gateway APT repository, then install the app.
#
#   curl -fsSL @BASE_URL@/install.sh | sh
#
# This writes two files and installs one package. Read it before piping it to a shell;
# everything it does is also spelled out at @BASE_URL@ if you would rather run the
# steps yourself.
set -eu

REPO_URL="@BASE_URL@"
KEYRING_URL="$REPO_URL/@KEYRING@"
KEYRING_PATH="/etc/apt/keyrings/@PACKAGE@.gpg"
SOURCES_PATH="/etc/apt/sources.list.d/@PACKAGE@.sources"

say() { printf '\033[1m%s\033[0m\n' "$*"; }
die() { printf 'install: %s\n' "$*" >&2; exit 1; }

command -v apt-get >/dev/null 2>&1 || die "this installer needs apt — see $REPO_URL for the AppImage"
command -v curl >/dev/null 2>&1 || die "curl is required"

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  command -v sudo >/dev/null 2>&1 || die "run this as root, or install sudo"
  SUDO="sudo"
fi

arch="$(dpkg --print-architecture)"
[ "$arch" = "@ARCH@" ] || die "only @ARCH@ is published; this machine is $arch — see $REPO_URL for the AppImage"

say "Installing the repository signing key into $KEYRING_PATH"
$SUDO install -d -m 0755 /etc/apt/keyrings
curl -fsSL "$KEYRING_URL" | $SUDO tee "$KEYRING_PATH" >/dev/null
$SUDO chmod 0644 "$KEYRING_PATH"

say "Writing $SOURCES_PATH"
$SUDO tee "$SOURCES_PATH" >/dev/null <<EOF
Types: deb
URIs: $REPO_URL
Suites: @SUITE@
Components: @COMPONENT@
Architectures: @ARCH@
Signed-By: $KEYRING_PATH
EOF

say "Updating package lists"
$SUDO apt-get update

say "Installing @PACKAGE@"
$SUDO apt-get install -y @PACKAGE@

say "Done. Launch it from your application menu, or run: @PACKAGE@"
